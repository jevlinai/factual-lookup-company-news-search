# Vendor API keys — required only to re-run live search calls.
TINYFISH_API_KEY=
PARALLEL_API_KEY=
RAPIDAPI_KEY=
PERPLEXITY_API_KEY=
LINKUP_API_KEY=
FIRECRAWL_API_KEY=
BRAVE_SEARCH_API_KEY=
YDC_API_KEY=
# YOU_API_KEY=   # alias for YDC_API_KEY
EXA_API_KEY=
TAVILY_API_KEY=

# Extract model (published snapshot: gpt-5.6-terra, medium reasoning).
OPENAI_API_KEY=

# Accuracy + AR@K judge (published snapshot: Claude Opus 5 on Bedrock converse).
# Do not use ANTHROPIC_API_KEY.
# AWS_BEARER_TOKEN_BEDROCK=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# BEDROCK_JUDGE_MODEL=us.anthropic.claude-opus-5

# Nimble Search / Agents
NIMBLE_API_KEY=

# ── Jevlin arms (jevlin-backend fork; see scripts/websearch/jevlin_news.py) ──
# Portal/project key for the HTTP arms. Never exported to the extractor or judge sessions.
JEVLIN_API_KEY=
# Base URL; default https://api.jevlin.ai. The 2026-10-15 runs used https://router-api.nyks.dev.
# JEVLIN_API_URL=https://api.jevlin.ai
# Pinned provider set for jevlin_fanout_raw / jevlin_fanout_merged (required by those arms).
# Pin it to what the preflight resolves for the balanced tier on the day, e.g.:
# JEVLIN_PROVIDERS=exa,brave,serpapi,tinyfish,you
# Provider for jevlin_single (default exa).
# JEVLIN_SINGLE_PROVIDER=exa
# HTTP timeout in seconds (default 45; Jevlin's own fan-out deadline is 30 s).
# JEVLIN_TIMEOUT_S=45
# Optional: pin the Codex judge model (`codex exec -m`). Leave unset for the CLI default.
# CODEX_JUDGE_MODEL=
# Optional: retarget the official rejudge/score chain at another run directory.
# NEWS_RUN_DIR=data/company-news/official-runs/<stamp>
#
# NOT used by this fork's adaptation: the extractor is a tool-isolated Claude Code
# session on the subscription (no ANTHROPIC_API_KEY), the semantic judge is `codex exec` on
# the ChatGPT login (no OPENAI_API_KEY). OPENAI_API_KEY / Bedrock are only for the upstream
# official chain (--extractor openai; rejudge_official_*.py).
